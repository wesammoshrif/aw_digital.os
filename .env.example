# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PW@db.YOUR_PROJECT.supabase.co:5432/postgres
# Auf true setzen sobald DATABASE_URL gesetzt ist — steuert den Mock-Modus im Browser
NEXT_PUBLIC_DB_CONNECTED=true

# ── KI / Souffleur ────────────────────────────────────────────────
# Haiku 4.5 für Live-Tipps + Sonnet für Post-Call-Summary.
# Ohne Key läuft der Souffleur lokal (Einwand-Playbook + Browser-Mikro).
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: stärkeres Modell für die diskrete KI-Mitarbeiter-Bewertung
# (Phase 8, /team/[id]). Default: claude-haiku-4-5. Ohne Key: rein rechnerisch.
# AGENT_REVIEW_MODEL=claude-sonnet-4-6
# Echtzeit-STT für die KUNDEN-Stimme (PC-Ton). Für SICHERE Kurzzeit-Tokens
# (/auth/grant) MUSS dies ein OWNER/Admin-Key sein — ein Member-Key gibt 403
# und die Kunden-Transkription bleibt dann aus.
DEEPGRAM_API_KEY=
# Nur LOKALE Tests: schiebt den Roh-Key in den Browser, wenn /auth/grant
# scheitert (UNSICHER — Key in der Netzwerkkonsole sichtbar). In Production LEER!
DEEPGRAM_ALLOW_RAW_KEY=
# Optional: EU-Hosting-Alternative zu Deepgram
GLADIA_API_KEY=

# ── Audit ─────────────────────────────────────────────────────────
PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Telefonie (easybell) ──────────────────────────────────────────
# WICHTIG: easybell hat KEINE Click-to-Call REST-API (api.easybell.de existiert
# nicht). Anrufe laufen per tel:-Link (Desktop-App) ODER per WebRTC-Softphone
# im Souffleur-Popup. Für WebRTC die SIP-Zugangsdaten aus dem easybell-Portal:
EASYBELL_SIP_USERNAME=
EASYBELL_SIP_PASSWORD=
EASYBELL_SIP_REGISTRAR=voip.easybell.de
# WebRTC-Gateway-Host existiert, Port :7443 ist NICHT offiziell dokumentiert —
# beim ersten Browser-Anruf live prüfen, ggf. anpassen.
EASYBELL_SIP_WSS=wss://webrtc.easybell.de:7443
EASYBELL_SIP_DISPLAYNAME=AW Digital
# Angezeigte Nummer beim Angerufenen (CLIP), Format +49…
EASYBELL_CLIP=

# ── Asterisk-Brücke (echtes In-Browser-Telefonieren, siehe voip-bridge/) ──
# Eigener VPS mit Asterisk registriert den easybell-Trunk und gibt dem Browser
# ein WSS-Gateway. Sind diese gesetzt, nutzt der Dialer die Brücke statt easybell.
ASTERISK_WSS=
ASTERISK_SIP_DOMAIN=
ASTERISK_SIP_USER=cockpit
ASTERISK_SIP_PASSWORD=

# ── Owner (Alt: single-tenant Default-Owner für Bestandsdaten) ────
OWNER_ID=00000000-0000-0000-0000-000000000001

# ── Team / Auth (Multi-User) ──────────────────────────────────────
# Diese E-Mails werden bei Registrierung automatisch admin + freigegeben.
# Kommagetrennt. Leer = niemand wird automatisch Admin.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ── Automatik (Reminder/E-Mail) ──────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=AW Digital <noreply@deine-domain.de>
# Schützt /api/cron/tick. In Production PFLICHT (sonst 503/fail-closed).
# Der Docker-Cron-Sidecar sendet ihn als x-cron-secret.
CRON_SECRET=

# ── Zugangsschutz (DEPLOY!) ──────────────────────────────────────
# ⚠️ In Production ist APP_PASSWORD PFLICHT. Ist es leer, antwortet die App mit
# 503 (fail-closed) und der Boot bricht ab — sie ist dann NICHT öffentlich.
# Ein starkes Passwort setzen → die Middleware sperrt die App per Basic-Auth.
APP_USER=aw
APP_PASSWORD=
