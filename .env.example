# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PW@db.YOUR_PROJECT.supabase.co:5432/postgres
# Auf true setzen sobald DATABASE_URL gesetzt ist — steuert den Mock-Modus im Browser
NEXT_PUBLIC_DB_CONNECTED=true

# ── KI / Souffleur ────────────────────────────────────────────────
# Haiku 4.5 für Live-Tipps + Sonnet für Post-Call-Summary.
# Ohne Key läuft der Souffleur lokal (Einwand-Playbook + Browser-Mikro).
ANTHROPIC_API_KEY=sk-ant-xxx
# Echtzeit-STT für die KUNDEN-Stimme (PC-Ton). Ohne Key: nur dein Mikro
# wird transkribiert (Browser Web Speech API).
DEEPGRAM_API_KEY=
# Optional: EU-Hosting-Alternative zu Deepgram
GLADIA_API_KEY=

# ── Audit ─────────────────────────────────────────────────────────
PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Telefonie (easybell) ──────────────────────────────────────────
# WICHTIG: easybell hat KEINE Click-to-Call REST-API (api.easybell.de existiert
# nicht). Anrufe laufen per tel:-Link (Desktop-App) ODER per WebRTC-Softphone
# im Souffleur-Popup. Für WebRTC die SIP-Zugangsdaten aus dem easybell-Portal:
EASYBELL_SIP_USERNAME=
EASYBELL_SIP_PASSWORD=
EASYBELL_SIP_REGISTRAR=voip.easybell.de
# WebRTC-Gateway-Host existiert, Port :7443 ist NICHT offiziell dokumentiert —
# beim ersten Browser-Anruf live prüfen, ggf. anpassen.
EASYBELL_SIP_WSS=wss://webrtc.easybell.de:7443
EASYBELL_SIP_DISPLAYNAME=AW Digital
# Angezeigte Nummer beim Angerufenen (CLIP), Format +49…
EASYBELL_CLIP=

# ── Asterisk-Brücke (echtes In-Browser-Telefonieren, siehe voip-bridge/) ──
# Eigener VPS mit Asterisk registriert den easybell-Trunk und gibt dem Browser
# ein WSS-Gateway. Sind diese gesetzt, nutzt der Dialer die Brücke statt easybell.
ASTERISK_WSS=
ASTERISK_SIP_DOMAIN=
ASTERISK_SIP_USER=cockpit
ASTERISK_SIP_PASSWORD=

# ── Owner (single-tenant) ─────────────────────────────────────────
OWNER_ID=00000000-0000-0000-0000-000000000001

# ── Automatik (Reminder/E-Mail) ──────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=AW Digital <noreply@deine-domain.de>
# Schützt /api/cron/tick. In Vercel setzen → Vercel sendet ihn als Bearer-Token.
CRON_SECRET=

# ── Zugangsschutz (DEPLOY!) ──────────────────────────────────────
# ⚠️ WICHTIG für Production: solange APP_PASSWORD LEER ist, ist die App
# ÖFFENTLICH erreichbar. In Vercel ein starkes APP_PASSWORD setzen → die
# Middleware (src/middleware.ts) sperrt dann die ganze App per Basic-Auth.
APP_USER=aw
APP_PASSWORD=
